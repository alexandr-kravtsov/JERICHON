# 1. Игнорируем ТЯЖЕЛЫЙ storage по умолчанию
data/for_ml/storage/

# 2. РАЗРЕШАЕМ папку с сэмплами (важно: порядок строк имеет значение!)
!data/for_ml/storage/sample_storage/
# Если внутри sample_storage лежат .parquet файлы, а ниже есть правило *.parquet, их тоже нужно разрешить:
!data/for_ml/storage/sample_storage/**/*.parquet

# 3. Игнорируем мусор, который ты указал
archive/
tools/

# 4. Стандартный мусор Python и IDE
__pycache__/
*.py[cod]
*$py.class
.env
.env.local
*.log
logs/
.vscode/
.idea/
*.swp
*.swo